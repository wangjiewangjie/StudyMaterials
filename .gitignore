# Dependencies (regenerated by npm install)
node_modules/
frontend/node_modules/

# Frontend production build (regenerated by: cd frontend && npm run build)
public/build/

# Runtime data (regenerated on startup crawl)
output/
.server-port

# Electron 打包产物
dist-electron/

# 由 npm run icons 从 build/logo.ico 生成
build/icon.png
build/icon.ico
build/app-icon.ico

# Logs
*.log
npm-debug.log*

# Environment / secrets
.env
.env.*

# OS
.DS_Store
Thumbs.db

# Editor / AI 工具缓存
.vscode/
.idea/
.trae/
.cursor/
